{
  "annotations": {
    "list": []
  },
  "description": "按 Node 展示 Chestnut API 的节点采集健康、请求流量、错误率和集群延迟概览。",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "chestnut"
      ],
      "targetBlank": false,
      "title": "Chestnut 仪表盘",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "筛选与集群健康",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "当前筛选范围内 Prometheus up=1 的节点数，仅表示 /metrics 可正常采集。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "semi-dark-blue",
            "mode": "fixed"
          },
          "min": 0,
          "noValue": "无节点采集数据",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(up{job=\"chestnut-api\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "可用",
          "refId": "A"
        }
      ],
      "title": "可用节点数",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "当前筛选范围内 Prometheus up=0 的节点数，表示 /metrics 当前无法采集。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "无节点采集数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "count(up{job=\"chestnut-api\",node=~\"$node\"}) - sum(up{job=\"chestnut-api\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "不可用",
          "refId": "A"
        }
      ],
      "title": "不可用节点数",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Prometheus 可采集节点占全部筛选节点的比例；没有 up 序列时显示无节点采集数据。",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "max": 100,
          "min": 0,
          "noValue": "无节点采集数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * sum(up{job=\"chestnut-api\",node=~\"$node\"}) / count(up{job=\"chestnut-api\",node=~\"$node\"})",
          "instant": true,
          "legendFormat": "可用率",
          "refId": "A"
        }
      ],
      "title": "节点可用率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "当前筛选节点正在处理且未按路径排除的业务请求总数；背景趋势展示所选时间范围内的变化。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "semi-dark-blue",
            "mode": "fixed"
          },
          "min": 0,
          "noValue": "无节点数据",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(chestnut_http_server_requests_in_flight{job=\"chestnut-api\",node=~\"$node\"})",
          "instant": false,
          "legendFormat": "处理中请求",
          "refId": "A"
        }
      ],
      "title": "当前并发请求数",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "当前筛选范围内最近启动节点的进程已运行时长，用于发现近期重启。",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "min": 0,
          "noValue": "无进程数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "suffix: 小时"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(time() - max(process_start_time_seconds{job=\"chestnut-api\",node=~\"$node\"})) / 3600",
          "instant": true,
          "legendFormat": "运行时长",
          "refId": "A"
        }
      ],
      "title": "最近启动节点运行时长",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "直接基于 Prometheus up 展示每个节点的名称、采集地址和 UP/DOWN 状态，仅表示 /metrics 采集健康。",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "异常"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "正常"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "无节点采集数据"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "采集时间"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "采集状态"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 37,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "sortBy": [],
        "showHeader": true
      },
      "targets": [
        {
          "expr": "max by (job, node, instance) (up{job=\"chestnut-api\",node=~\"$node\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}} · {{instance}}",
          "refId": "A"
        }
      ],
      "title": "节点采集明细",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": false,
                "field": "node"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "instance": true,
              "job": true
            },
            "includeByName": {},
            "indexByName": {
              "Time": 0,
              "Value": 2,
              "node": 1
            },
            "renameByName": {
              "Time": "采集时间",
              "Value": "采集状态",
              "node": "节点"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 10,
      "panels": [],
      "title": "流量与可靠性",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "全部业务路由 QPS；404、探活和 /metrics 已在采集端排除。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "无请求数据",
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "QPS",
          "refId": "A"
        }
      ],
      "title": "集群总 QPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按最终 HTTP 状态类别展示业务请求速率；仅保留 2xx、3xx、4xx、5xx，不区分具体状态码。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "无请求数据",
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\",status_class=\"2xx\"}[$__rate_interval]))",
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\",status_class=\"3xx\"}[$__rate_interval]))",
          "legendFormat": "3xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\",status_class=\"4xx\"}[$__rate_interval]))",
          "legendFormat": "4xx",
          "refId": "C"
        },
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\",status_class=\"5xx\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "D"
        }
      ],
      "title": "HTTP 状态类别趋势",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "HTTP 5xx 请求速率占全部业务请求速率的百分比；有请求但无 5xx 时显示 0%，无请求时保持无数据。",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "max": 100,
          "min": 0,
          "noValue": "无请求数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "id": 13,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\",status_class=\"5xx\"}[$__rate_interval])) or vector(0)) / (sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) > 0)",
          "instant": true,
          "legendFormat": "5xx 比例",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx 比例",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "最近 5 分钟被 Recovery 捕获的 panic 数量；目标存在且从未发生 panic 时显示 0，目标数据缺失时保持不可用。",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "noValue": "无 Recovery 数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "suffix: 次"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum(increase(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",node=~\"$node\"}[5m])) or vector(0)) and on() (count(up{job=\"chestnut-api\",node=~\"$node\"}) > 0)",
          "instant": true,
          "legendFormat": "Recovered panic",
          "refId": "A"
        }
      ],
      "title": "Recovery Panic 增量",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 展示 Recovery panic 速率。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "无 Recovery 数据",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 6,
        "y": 20
      },
      "id": 15,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Recovery Panic 趋势",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 16,
      "panels": [],
      "title": "延迟",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "先跨节点按 le 聚合 classic Histogram bucket，再计算集群分位数。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "无请求数据",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 17,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "title": "集群延迟分位数",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Histogram sum 增长率除以 count 增长率。",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "无请求数据",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 18,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(chestnut_http_server_request_duration_seconds_sum{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) / (sum(rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) > 0)",
          "legendFormat": "平均耗时",
          "refId": "A"
        }
      ],
      "title": "平均耗时",
      "type": "timeseries"
    }
  ],
  "preload": false,
  "refresh": "30s",
