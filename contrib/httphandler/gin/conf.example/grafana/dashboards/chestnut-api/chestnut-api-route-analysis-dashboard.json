          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "mappings": [],
          "min": 0,
          "noValue": "无请求数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
