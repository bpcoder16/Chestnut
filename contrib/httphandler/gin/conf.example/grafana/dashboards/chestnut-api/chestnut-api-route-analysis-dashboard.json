            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 13,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 19,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (increase(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}}",
          "refId": "A"
        },
        {
          "expr": "sum by (route) (increase(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",node=~\"$node\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}}",
          "refId": "B"
        },
        {
          "expr": "100 * (1 - sum by (route) (increase(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\",le=\"0.5\"}[$__range])) / (sum by (route) (increase(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",node=~\"$node\"}[$__range])) > 0))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}}",
          "refId": "C"
        }
      ],
      "title": "所选时段 P95 最慢路由 Top 10",
