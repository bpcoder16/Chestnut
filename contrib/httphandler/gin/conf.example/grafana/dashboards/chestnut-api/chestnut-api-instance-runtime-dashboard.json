    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 展示当前处理中的普通 HTTP 请求数，由总 in-flight 减去 WebSocket 连接数得到；曲线表示各采样时刻的请求数，健康节点无序列时补 0。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "无节点数据",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 29,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "sortBy": "Name",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "clamp_min((sum by (node) (chestnut_http_server_requests_in_flight{job=\"chestnut-api\",node=~\"$node\"}) or 0 * max by (node) (up{job=\"chestnut-api\",node=~\"$node\"} == 1)) - (sum by (node) (chestnut_http_server_websocket_connections{job=\"chestnut-api\",node=~\"$node\"}) or 0 * max by (node) (up{job=\"chestnut-api\",node=~\"$node\"} == 1)), 0)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "各节点 HTTP 并发请求趋势",
      "type": "timeseries"
    },
