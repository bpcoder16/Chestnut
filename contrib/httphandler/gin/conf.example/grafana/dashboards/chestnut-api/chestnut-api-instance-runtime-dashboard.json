      "targets": [
        {
          "expr": "sum by (node) (rate(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) or 0 * max by (node) (up{job=\"chestnut-api\",node=~\"$node\"} == 1)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "各节点 Recovery Panic 趋势",
