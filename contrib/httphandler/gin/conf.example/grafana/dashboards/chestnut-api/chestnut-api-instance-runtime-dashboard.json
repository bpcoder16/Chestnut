      "targets": [
        {
          "expr": "100 * sum by (node) (rate(process_cpu_seconds_total{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) / max by (node) (go_sched_gomaxprocs_threads{job=\"chestnut-api\",node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "进程 CPU 占整机比例",
