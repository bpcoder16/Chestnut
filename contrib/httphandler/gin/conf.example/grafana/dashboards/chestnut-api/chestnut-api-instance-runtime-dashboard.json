      "targets": [
        {
          "expr": "sum by (node) (rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\",status_class=\"5xx\"}[$__rate_interval])) or 0 * max by (node) (up{job=\"chestnut-api\",node=~\"$node\"} == 1)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "各节点 5xx QPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 展示 Recovery panic 速率；健康节点从未发生或当前没有 panic 时补齐为 0，不可采集节点不补零。",
