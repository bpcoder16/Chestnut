      },
      "id": 25,
      "panels": [],
      "title": "节点定位",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 对比请求速率；健康但尚无请求序列的节点显示为 0。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "无请求数据",
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 26,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "sortBy": "Name",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(chestnut_http_server_requests_total{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) or 0 * max by (node) (up{job=\"chestnut-api\",node=~\"$node\"} == 1)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "各节点 QPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 聚合 bucket 后计算 P95，不平均节点分位数；健康但当前窗口无有效耗时样本的节点显示为 0。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "无请求数据",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 27,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "sortBy": "Name",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (le, node) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval]))) and on (node) (sum by (node) (rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",node=~\"$node\"}[$__rate_interval])) > 0)) or 0 * max by (node) (up{job=\"chestnut-api\",node=~\"$node\"} == 1)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "各节点 P95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 展示 HTTP 5xx 请求速率；健康但无 5xx 请求序列的节点显示为 0。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "无请求数据",
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
