{
  "annotations": {
    "list": []
  },
  "description": "按单个 Route 展示 Chestnut API 在全部节点上的请求流量、状态类别、延迟和 Recovery Panic 趋势。",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "chestnut"
      ],
      "targetBlank": false,
      "title": "Chestnut 仪表盘",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Route 流量",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "所选 Route 在全部节点上的请求速率；404、探活和 /metrics 已在采集端排除。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "semi-dark-blue",
            "mode": "fixed"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "请选择 Route",
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "QPS",
          "refId": "A"
        }
      ],
      "title": "集群总 QPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按最终 HTTP 状态类别展示所选 Route 在全部节点上的请求速率；仅保留 2xx、3xx、4xx、5xx。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "请选择 Route",
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",route=\"$route\",status_class=\"2xx\"}[$__rate_interval])) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "2xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",route=\"$route\",status_class=\"3xx\"}[$__rate_interval])) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "3xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",route=\"$route\",status_class=\"4xx\"}[$__rate_interval])) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "4xx",
          "refId": "C"
        },
        {
          "expr": "sum(rate(chestnut_http_server_requests_total{job=\"chestnut-api\",route=\"$route\",status_class=\"5xx\"}[$__rate_interval])) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "5xx",
          "refId": "D"
        }
      ],
      "title": "HTTP 状态类别趋势",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "panels": [],
      "title": "Route 延迟",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "所选 Route 的普通 HTTP 请求先跨节点按 le 聚合 classic Histogram bucket，再计算分位数；WebSocket 升级请求在采集端排除。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "请选择 Route",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval]))) and on() (sum(rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) > 0)) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "(histogram_quantile(0.90, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval]))) and on() (sum(rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) > 0)) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "P90",
          "refId": "B"
        },
        {
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval]))) and on() (sum(rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) > 0)) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "expr": "(histogram_quantile(0.99, sum by (le) (rate(chestnut_http_server_request_duration_seconds_bucket{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval]))) and on() (sum(rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) > 0)) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "title": "HTTP 请求延迟分位数",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "所选 Route 的普通 HTTP 请求 Histogram sum 增长率除以 count 增长率；WebSocket 升级请求在采集端排除。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "请选择 Route",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(chestnut_http_server_request_duration_seconds_sum{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) / (sum(rate(chestnut_http_server_request_duration_seconds_count{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval])) > 0)) or 0 * sum(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"})",
          "instant": false,
          "legendFormat": "HTTP 平均响应耗时",
          "refId": "A"
        }
      ],
      "title": "HTTP 平均响应耗时",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 7,
      "panels": [],
      "title": "Route 异常",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 展示所选 Route 的 Recovery panic 速率；计数器按注册路由预初始化，未发生 panic 时保留 0，未选择 Route 时无序列。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "请选择 Route",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "sortBy": "Name",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(chestnut_http_server_recovered_panics_total{job=\"chestnut-api\",route=\"$route\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Recovery Panic 趋势",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按 node 展示所选 Route 返回 JSON 顶层业务 code=400 的每秒速率；计数器按注册路由预初始化，未发生时保留 0，未选择 Route 时无序列。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "never"
          },
          "min": 0,
          "noValue": "请选择 Route",
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "sortBy": "Name",
          "sortDesc": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (node) (rate(chestnut_http_server_business_responses_total{job=\"chestnut-api\",route=\"$route\",code=\"400\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "业务 code=400 趋势",
      "type": "timeseries"
    }
  ],
